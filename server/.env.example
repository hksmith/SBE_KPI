# MongoDB connection string. Local: mongodb://127.0.0.1:27017/worktrack  Atlas: mongodb+srv://USER:PASS@cluster0.xxxx.mongodb.net/worktrack?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/worktrack
# Long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
PORT=4000
# First admin account, created automatically on first start if no admin exists
ADMIN_NAME=System Admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
# Only needed when the frontend runs on a different origin than the API (e.g. Vite dev server)
CLIENT_ORIGIN=http://localhost:5173
